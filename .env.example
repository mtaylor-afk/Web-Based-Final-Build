# ── Database ────────────────────────────────────────────────────────────────
# Vercel/Neon PostgreSQL (get from neon.tech dashboard → Connection string)
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Neon uses a separate direct connection for migrations/prisma db push
DIRECT_URL="postgresql://user:password@ep-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# ── AI (optional — stubs work without it) ───────────────────────────────────
OPENAI_API_KEY="sk-..."

# ── App ─────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="change-me-to-a-random-32-char-string"
NEXTAUTH_URL="https://your-app.vercel.app"

# ── File uploads ─────────────────────────────────────────────────────────────
# Vercel Blob (get from Vercel dashboard → Storage → Blob → Create Store)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── Seed protection ──────────────────────────────────────────────────────────
# Set a random secret — used to call POST /api/seed after first deploy
SEED_SECRET="change-me"

# ── Local development only ───────────────────────────────────────────────────
# Uncomment these and comment out the PostgreSQL DATABASE_URL above:
# DATABASE_URL="file:./dev.db"
# DIRECT_URL="file:./dev.db"
